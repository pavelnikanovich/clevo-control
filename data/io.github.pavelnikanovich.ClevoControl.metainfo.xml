<component type="desktop-application">
  <id>io.github.pavelnikanovich.ClevoControl</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <name>Clevo Control</name>
  <summary>Keyboard backlight and performance profile of Clevo laptops</summary>
  <description>
    <p>
      Tray applet for Clevo laptops: choose the color and brightness of the RGB
      keyboard backlight and the firmware performance profile.
    </p>
    <p>
      It works together with the clevo-control kernel module, which exposes the
      keyboard backlight, its Fn keys and the performance profiles through
      standard kernel interfaces.
    </p>
  </description>
  <launchable type="desktop-id">io.github.pavelnikanovich.ClevoControl.desktop</launchable>
  <url type="homepage">https://github.com/pavelnikanovich/clevo-control</url>
  <url type="bugtracker">https://github.com/pavelnikanovich/clevo-control/issues</url>
  <developer id="io.github.pavelnikanovich">
    <name>Pavel Nikanovich</name>
  </developer>
  <provides>
    <binary>clevo-control-tray</binary>
    <binary>clevoctl</binary>
    <modalias>acpi*:CLV0001:*</modalias>
    <modalias>wmi:ABBC0F6D-8EA1-11D1-00A0-C90629100000</modalias>
  </provides>
  <categories>
    <category>Settings</category>
    <category>HardwareSettings</category>
  </categories>
  <content_rating type="oars-1.1"/>
</component>
